# Chiave OpenAI: embedding e chiamate dell'agente.
OPENAI_API_KEY=
# Chiave condivisa con il frontend Laravel (header X-Internal-Key).
INTERNAL_API_KEY=cambiami
# Dove vivono vettori, tabelle, file e sessioni. Un percorso relativo parte da backend/.
DATA_DIR=data

# Modelli.
MODEL=gpt-5.6-luna
EMBEDDING_MODEL=text-embedding-3-small
# Quanti testi per chiamata all'API degli embedding.
EMBEDDING_BATCH=100

# Retrieval: caratteri per chunk e chunk restituiti da cerca_documenti.
CHUNK_SIZE=500
TOP_K=4
# Passaggi massimi dell'agente in un turno di chat.
MAX_TURNS=10
# Turni precedenti della conversazione che il modello rilegge a ogni messaggio.
SESSION_HISTORY_TURNS=10

# Limiti per agente.
MAX_UPLOAD_MB=10
# Chunk al massimo per documento: un documento più lungo va diviso in più file.
MAX_CHUNKS_PER_DOCUMENT=2000
MAX_DOCUMENTS_PER_AGENT=20
MAX_TABLES_PER_AGENT=10
# Righe al massimo restituite da query_db (al modello) e dalla console SQL (all'utente).
QUERY_DB_LIMIT=50
SQL_CONSOLE_LIMIT=200

# Tracce dell'Agents SDK: spente, perché porterebbero alla dashboard OpenAI domande,
# passaggi dei documenti e righe delle tabelle. Per vederle (solo con dati di prova)
# metti false e guardale su https://platform.openai.com/traces.
OPENAI_AGENTS_DISABLE_TRACING=true
